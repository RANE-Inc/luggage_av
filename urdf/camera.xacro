<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="params.xacro" />

    <material name="camera_black">
        <color rgba="0 0 0 1"/>
    </material>

    <joint name="camera_joint" type="fixed">
        <parent link="lidar_mount_link"/>
        <child link="base_camera"/>
        <origin xyz="${camera_x_offset} ${camera_y_offset} ${camera_z_offset}" rpy="${-pi/2} 0 ${-pi/2}"/> <!--half the height of the mount + half the height of the lidar itself -->
    </joint>

    <link name="base_camera">
        <visual>
            <origin xyz="0 0 ${-camera_width/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${camera_length} ${camera_height} ${camera_width}" />
            </geometry>
            <material name="camera_black"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${-camera_width/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${camera_length} ${camera_height} ${camera_width}" />
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.1" x="${camera_length}" y="${camera_height}" z="${camera_width}" >
            <origin xyz="0 0 ${-camera_width/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>


    <gazebo reference="base_camera">
        <material>Gazebo/Black</material>

        <sensor name="camera" type="camera">
            <pose> 0 0 0 ${pi/2} ${-pi/2} 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera name="logitech_c920">
                <camera_info_topic>camera_info</camera_info_topic>
                <horizontal_fov>1.229061</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>800</width>
                    <height>600 </height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <topic>/$(arg namespace)/image_raw</topic>
            <gz_frame_id>$(arg namespace)/base_camera</gz_frame_id>
        </sensor>
    </gazebo>

</robot>
