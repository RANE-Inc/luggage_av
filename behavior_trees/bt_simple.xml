<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="root_bt">
  <BehaviorTree ID="root_bt">
    <sequence>
            <WaitForRoute pickup_pose="{pickup}" dropoff_pose="{dropoff}"/>
            <NavigateToLocation name="{pickup}"/>
            <NavigateToLocation name="{dropoff}"/>
        </sequence>
  </BehaviorTree>
</root>