<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Project">
    <include path="main_bt.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="DropoffPassenger"/>
        <Action ID="Dropoff_Passenger" editable="true"/>
        <Action ID="NavigateToPose">
            <input_port name="goal" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Destination to plan to</input_port>
            <input_port name="behavior_tree" type="std::string">Behavior tree to run</input_port>
            <output_port name="error_code_id" type="unsigned short">Navigate to pose error code</output_port>
            <input_port name="server_timeout" type="std::chrono::milliseconds"/>
            <input_port name="server_name" type="std::string">Action server name</input_port>
        </Action>
        <Action ID="Pickup_Passenger"/>
        <Action ID="Report_Failure"/>
        <Action ID="WaitForRoute">
            <output_port name="pickup_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Stamped Extracted Pose</output_port>
            <output_port name="dropoff_pose" type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Stamped Extracted Pose</output_port>
        </Action>
        <Action ID="Yapper"/>
    </TreeNodesModel>
</root>
